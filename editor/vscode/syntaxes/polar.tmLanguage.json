{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Polar",
  "scopeName": "source.polar",
  "fileTypes": ["px"],
  "patterns": [{ "include": "#code" }],
  "repository": {
    "code": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#zones" },
        { "include": "#plugin-entries" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#function-def" },
        { "include": "#function-call" },
        { "include": "#types" },
        { "include": "#operators" },
        { "include": "#punctuation" },
        { "include": "#identifiers" }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.polar",
          "match": "(///)(?!/).*$",
          "captures": {
            "0": { "patterns": [{ "include": "#doc-code" }] },
            "1": { "name": "punctuation.definition.comment.polar" }
          }
        },
        {
          "name": "comment.line.double-slash.polar",
          "match": "(//).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.polar" } }
        }
      ]
    },
    "doc-code": {
      "match": "`[^`]*`",
      "name": "markup.inline.raw.polar"
    },
    "zones": {
      "match": "^(module|uses|hosts|traits|schema|types|constants|effects|externs|binds|routes|functions|impls|exports)\\b",
      "name": "keyword.other.zone.polar"
    },
    "plugin-entries": {
      "patterns": [
        {
          "match": "^\\s+(GET|POST|PUT|PATCH|DELETE)\\s+(/[^\\s]*)",
          "captures": {
            "1": { "name": "keyword.other.method.polar" },
            "2": { "name": "string.unquoted.path.polar" }
          }
        },
        {
          "match": "\\b(primary|references)\\b",
          "name": "storage.modifier.polar"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.polar",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.polar" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.polar" } },
      "patterns": [
        {
          "name": "constant.character.escape.polar",
          "match": "\\\\(?:[nrt\\\\\"#]|u\\{[0-9A-Fa-f]{1,6}\\})"
        },
        {
          "name": "invalid.illegal.escape.polar",
          "match": "\\\\."
        },
        { "include": "#interpolation" }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.polar",
      "begin": "#\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.polar" } },
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.polar" } },
      "contentName": "source.polar.embedded",
      "patterns": [{ "include": "#braced" }, { "include": "#code" }]
    },
    "braced": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.braces.begin.polar" } },
      "endCaptures": { "0": { "name": "punctuation.section.braces.end.polar" } },
      "patterns": [{ "include": "#braced" }, { "include": "#code" }]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.polar",
          "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*(?:[eE][+-]?\\d[\\d_]*)?|[eE][+-]?\\d[\\d_]*)\\b"
        },
        {
          "name": "constant.numeric.integer.polar",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.polar",
          "match": "\\b(match|if|else|throw|try|catch)\\b"
        },
        {
          "name": "constant.language.boolean.polar",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "storage.type.function.polar",
          "match": "\\bfunction\\b"
        },
        {
          "name": "storage.modifier.polar",
          "match": "\\b(let|derive|as|in|native|force|from)\\b"
        },
        {
          "name": "invalid.deprecated.reserved.polar",
          "match": "\\b(type|import|pub|export|host|effect|bind|extern)\\b"
        },
        {
          "name": "variable.language.wildcard.polar",
          "match": "\\b_\\b"
        }
      ]
    },
    "function-def": {
      "match": "^(?:  |\\t)([a-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": { "1": { "name": "entity.name.function.polar" } }
    },
    "function-call": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": { "1": { "name": "entity.name.function.call.polar" } }
    },
    "types": {
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
      "name": "entity.name.type.polar"
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.polar", "match": "->" },
        { "name": "keyword.operator.pipe.polar", "match": "\\|>" },
        { "name": "keyword.operator.spread.polar", "match": "\\.\\." },
        { "name": "keyword.operator.comparison.polar", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.polar", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.arithmetic.polar", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.bitwise.polar", "match": "[&^~]" },
        { "name": "keyword.operator.assignment.polar", "match": "=" },
        { "name": "keyword.operator.union.polar", "match": "\\|" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.polar", "match": "," },
        { "name": "punctuation.separator.colon.polar", "match": ":" },
        { "name": "punctuation.accessor.polar", "match": "\\." }
      ]
    },
    "identifiers": {
      "match": "\\b[a-z_][A-Za-z0-9_]*\\b",
      "name": "variable.other.polar"
    }
  }
}
