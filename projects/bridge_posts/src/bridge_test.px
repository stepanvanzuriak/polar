module BridgeTest

uses
  Std.Assert
  Std.List
  Std.Test

hosts
  Node

functions
  test_browser_calls_the_server_through_the_bridge() -> {} / {
    Async,
    Net,
    Throws<Failed>,
  } {
    Test.with_app(
      function(app) {
        let writes = Test.run_browser(app, "start")

        Test.assert_snapshot("browser", "#{List.join(writes, "\n")}\n")
      },
    )
  }

exports
  test_browser_calls_the_server_through_the_bridge
