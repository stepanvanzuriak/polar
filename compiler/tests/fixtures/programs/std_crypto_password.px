module StdCryptoPassword

uses
  Std.Crypto

hosts
  Node

functions
  weak() -> String {
    "$scrypt$ln=10,r=8,p=1$00112233445566778899aabbccddeeff$63a66fe3947702a6142ee48597a6dd3294a57531345796b0580a88121e0374ac"
  }

  huge() -> String {
    "$scrypt$ln=40,r=8,p=1$00112233445566778899aabbccddeeff$63a66fe3947702a6142ee48597a6dd3294a57531345796b0580a88121e0374ac"
  }

  main() -> {} / {Random, Password} {
    let a = Crypto.hash_password("pw")
    let b = Crypto.hash_password("pw")

    Log.info("roundtrip: #{Crypto.verify_password("pw", a)}")
    Log.info("salted: #{a != b} #{Crypto.verify_password("pw", b)}")
    Log.info("format: #{String.starts_with(a, "$scrypt$ln=15,r=8,p=1$")}")
    Log.info("wrong: #{Crypto.verify_password("px", a)} #{Crypto.verify_password("", a)}")
    Log.info(
      "unicode: #{Crypto.verify_password("héllo ✓", Crypto.hash_password("héllo ✓"))}",
    )
    Log.info(
      "garbage: #{Crypto.verify_password("pw", "$scrypt$")} #{Crypto.verify_password("pw", "")} #{Crypto.verify_password("pw", "not a digest")}",
    )
    Log.info(
      "unknown_alg: #{Crypto.verify_password("pw", "$argon2$ln=10,r=8,p=1$00$00")}",
    )
    Log.info(
      "bad_params: #{Crypto.verify_password("pw", "$scrypt$ln=abc,r=8,p=1$00$00")}",
    )
    Log.info("rehash_fresh: #{Crypto.needs_rehash(a)}")
    Log.info("rehash_weak: #{Crypto.needs_rehash(weak())}")
    Log.info("weak_verifies: #{Crypto.verify_password("pw", weak())}")
    Log.info("cost_cap: #{Crypto.verify_password("pw", huge())}")
  }

exports
  main
