module Assert

uses
  Std.Algo
  Std.List

types
  Failed = Failed(String)

functions
  assert(check: Bool) -> {} / {Throws<Failed>} {
    if !check { throw Failed(Bool.to_string(check)) } else { {} }
  }

  equal(actual: a, expected: a) -> {} / {Throws<Failed>} where Eq<a>, Show<a> {
    if actual == expected {
      {}
    } else {
      throw Failed("expected #{expected}, got #{actual}")
    }
  }

  not_equal(actual: a, other: a) -> {} / {Throws<Failed>} where Eq<a>, Show<a> {
    if actual != other {
      {}
    } else {
      throw Failed("expected a value other than #{other}")
    }
  }

  equal_text(actual: String, expected: String) -> {} / {Throws<Failed>} {
    if actual == expected {
      {}
    } else {
      throw Failed(
        List.join(
          [
            "texts differ (- expected, + actual)",
            ..changed_lines(String.split(expected, "\n"), String.split(actual, "\n")),
          ],
          "\n",
        ),
      )
    }
  }

  changed_lines(expected: List<String>, actual: List<String>) -> List<String> {
    List.concat_map(
      Algo.diff(expected, actual),
      function(edit) {
        match edit {
          Keep(_) -> [],
          Remove(line) -> ["- #{line.index}: #{line.value}"],
          Insert(line) -> ["+ #{line.index}: #{line.value}"],
        }
      },
    )
  }

  fail(message: String) -> a / {Throws<Failed>} {
    throw Failed(message)
  }

exports
  Failed
  assert
  equal
  not_equal
  equal_text
  fail
