module Process

uses
  Std.List
  Std.Option

hosts
  Node

types
  EnvVar = { name: String, value: String }

  RunOptions = { cwd: Option<String>, env: List<EnvVar>, input: Option<String> }

  Output = { code: Int, stdout: String, stderr: String }

  Child = { pid: Int, id: Int }

effects
  Process in Node {
    args() -> List<String>
    env(name: String) -> Option<String>
    cwd() -> String
    set_exit_code(code: Int) -> {}
    run(command: String, args: List<String>, options: RunOptions) -> Int
    output(command: String, args: List<String>, options: RunOptions) -> Output
  }

externs
  scoped_env(vars: List<EnvVar>, body: function() -> a / {| e}) -> a / {Async | e}
    = js "./bindings/Process.js" scoped_env,
      rs "process::scoped_env"
  spawn(command: String, args: List<String>, options: RunOptions) -> Child / {Async}
    = "./bindings/Process.js" spawn_child
  wait_for_line(child: Child, pattern: String, timeout_ms: Int) -> Option<String> / {
    Async,
  }
    = "./bindings/Process.js" wait_for_line
  lines(child: Child) -> List<String> = "./bindings/Process.js" lines
  sleep(ms: Int) -> {} / {Async} = "./bindings/Process.js" sleep
  stop(child: Child) -> Int / {Async} = "./bindings/Process.js" stop

binds
  Process in Node = "./bindings/Process.js"

  Process in Native = rs "process"

functions
  inherit() -> RunOptions {
    { cwd: None, env: [], input: None }
  }

  in_dir(options: RunOptions, dir: String) -> RunOptions {
    { ..options, cwd: Some(dir) }
  }

  with_input(options: RunOptions, input: String) -> RunOptions {
    { ..options, input: Some(input) }
  }

  with_env(options: RunOptions, name: String, value: String) -> RunOptions {
    { ..options, env: List.append(options.env, [{ name: name, value: value }]) }
  }

exports
  EnvVar
  RunOptions
  Output
  Child
  Node
  Process
  inherit
  in_dir
  with_env
  with_input
  scoped_env
  spawn
  wait_for_line
  lines
  sleep
  stop
