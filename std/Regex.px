module Regex

uses
  Std.List
  Std.Option
  Std.Result

hosts
  Node
  Browser

types
  Regex = Regex(String)

externs
  matches(pattern: String, text: String) -> Bool = "./bindings/Regex.js" test_pattern
  first_match(pattern: String, text: String) -> Option<String>
    = "./bindings/Regex.js" first_match
  all_matches(pattern: String, text: String) -> List<String>
    = "./bindings/Regex.js" all_matches
  capture_groups(pattern: String, text: String) -> Option<List<String>>
    = "./bindings/Regex.js" capture_groups
  replace_all(pattern: String, text: String, with: String) -> String
    = "./bindings/Regex.js" replace_all
  syntax_error(pattern: String) -> Option<String> = "./bindings/Regex.js" syntax_error

functions
  compile(pattern: String) -> Result<String, Regex> {
    match syntax_error(pattern) {
      None -> Ok(Regex(pattern)),
      Some(message) -> Err(message),
    }
  }

  pattern(regex: Regex) -> String {
    match regex {
      Regex(source) -> source,
    }
  }

  is_match(regex: Regex, text: String) -> Bool {
    matches(pattern(regex), text)
  }

  find(regex: Regex, text: String) -> Option<String> {
    first_match(pattern(regex), text)
  }

  find_all(regex: Regex, text: String) -> List<String> {
    all_matches(pattern(regex), text)
  }

  captures(regex: Regex, text: String) -> Option<List<String>> {
    capture_groups(pattern(regex), text)
  }

  replace(regex: Regex, text: String, with: String) -> String {
    replace_all(pattern(regex), text, with)
  }

impls
  Eq for Regex {
    eq(x, y) {
      pattern(x) == pattern(y)
    }
  }

  Show for Regex {
    show(regex) {
      "/#{pattern(regex)}/"
    }
  }

exports
  Regex
  Node
  Browser
  compile
  pattern
  is_match
  find
  find_all
  captures
  replace
  matches
