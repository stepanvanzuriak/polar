module Math

constants
  pi: Float = 3.141592653589793

functions
  // TODO: Replace Int with generic after the P-27
  max(x: Int, y: Int) -> Int {
    if x >= y { x } else { y }
  }

  min(x: Int, y: Int) -> Int {
    if x <= y { x } else { y }
  }

  abs(x: Int) -> Int {
    if x < 0 { -x } else { x }
  }

exports
  abs
  max
  min
  pi
