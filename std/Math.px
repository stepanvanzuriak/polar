module Math

constants
  pi: Float = 3.141592653589793

functions
  max(x: a, y: a) -> a where Ord<a> {
    if x >= y { x } else { y }
  }

  min(x: a, y: a) -> a where Ord<a> {
    if x <= y { x } else { y }
  }

  abs(x: a) -> a where Num<a>, Ord<a> {
    if x < Prelude.from_int(0) { -x } else { x }
  }

exports
  abs
  max
  min
  pi
