module Test

uses
  Std.Algo
  Std.Assert
  Std.Http
  Std.Json
  Std.List
  Std.Map
  Std.Option
  Std.Process
  Std.Ref
  Std.Result

hosts
  Node
  Browser
  Native

types
  Captured<a> = { output: String, value: a }

  Problem = { kind: String, message: String, at: String }

  Outcome = Pass | Fail(Problem) | Error(Problem) | Timeout

  Start = { event: String, name: String, file: String, line: Int } derive(Json)

  End = {
    event: String,
    name: String,
    outcome: String,
    ms: Float,
    kind: Option<String>,
    message: Option<String>,
    at: Option<String>,
  } derive(Json)

  RequestOptions = {
    method: String,
    url: String,
    headers: List<Header>,
    body: String,
    follow: Bool,
    timeout_ms: Int,
  }

  ClientError = Network(String) | TimedOut(String) derive(Show)

  Browser = { base: String, cookies: Map<String, String> }

  Visit = { browser: Browser, response: Response }

  App = { url: String, id: Int }

  Mismatch = { path: String, expected: String }

  Verdict = Match | Created | Missing(String) | Differ(Mismatch)

effects
  Net in Node {
    request(options: RequestOptions) -> Result<ClientError, Response>
  }

externs
  guard(run: function() -> {} / {| e}, timeout_ms: Int) -> Outcome / {Async | e}
    = js "./bindings/Test.js" guard,
      rs "test::guard"
  compare_snapshot(name: String, text: String, dir: String) -> Verdict / {Async}
    = js "./bindings/Test.js" compare_snapshot,
      rs "test::compare_snapshot"
  capture_raw(run: function() -> a / {| e}) -> Captured<a> / {Async | e}
    = js "./bindings/Test.js" capture,
      rs "test::capture"
  clock() -> Float
    = js "./bindings/Test.js" clock,
      rs "test::clock"
  finish() -> {}
    = js "./bindings/Test.js" finish,
      rs "test::finish"
  serve_app(env: List<EnvVar>, body: function(App) -> a / {| e}) -> a / {Async, Net | e}
    = "./bindings/Test.js" with_app
  run_browser(app: App, export_name: String) -> List<String> / {Async, Net}
    = "./bindings/Test.js" run_browser
  mock_effect(name: String, ops: o, body: function() -> a / {| e}) -> a / {Async | e}
    = js "./bindings/Test.js" mock,
      rs "test::mock"
  log(app: App) -> List<String> / {Mut, Net} = "./bindings/Test.js" log

binds
  Net in Node = "./bindings/Test.js"

functions
  assert_snapshot(name: String, text: String) -> {} / {Async, Throws<Failed>} {
    assert_snapshot_with(name, text, function(s) { s })
  }

  assert_snapshot_with(
    name: String,
    text: String,
    normalise: function(String) -> String,
  ) -> {} / {Async, Throws<Failed>} {
    let actual = normalise(text)

    match compare_snapshot(name, actual, "snapshots") {
      Match -> {},
      Created -> {},
      Missing(path) -> throw Failed(
        "no snapshot at #{path}\n  = help: run `POLAR_UPDATE=1 polar test` to create it",
      ),
      Differ(found) -> throw Failed(snapshot_diff(found, actual)),
    }
  }

  snapshot_diff(found: Mismatch, actual: String) -> String {
    let changes = List.concat_map(
      Algo.diff(String.split(found.expected, "\n"), String.split(actual, "\n")),
      function(edit) {
        match edit {
          Keep(_) -> [],
          Remove(line) -> ["- #{line.value}"],
          Insert(line) -> ["+ #{line.value}"],
        }
      },
    )

    List.join(["snapshot #{found.path} differs (- expected, + actual)", ..changes], "\n")
  }

  request_options(method: String, url: String) -> RequestOptions {
    { method: method, url: url, headers: [], body: "", follow: false, timeout_ms: 5000 }
  }

  request(options: RequestOptions) -> Result<ClientError, Response> / {Net} {
    Net.request(options)
  }

  get(url: String) -> Result<ClientError, Response> / {Net} {
    Net.request(request_options("GET", url))
  }

  capture(run: function() -> a / {| e}) -> Captured<a> / {Async | e} {
    capture_raw(run)
  }

  mock(name: String, ops: o, body: function() -> a / {| e}) -> a / {Async | e} {
    mock_effect(name, ops, body)
  }

  with_app(body: function(App) -> a / {| e}) -> a / {Async, Net | e} {
    serve_app([], body)
  }

  with_app_env(env: List<EnvVar>, body: function(App) -> a / {| e}) -> a / {
    Async,
    Net,
    | e
  } {
    serve_app(env, body)
  }

  send(app: App, method: String, path: String, body: String) -> Response / {
    Net,
    Throws<ClientError>,
  } {
    match Net.request({ ..request_options(method, "#{app.url}#{path}"), body: body }) {
      Ok(response) -> response,
      Err(error) -> throw error,
    }
  }

  session(base: String) -> Ref<Browser> {
    Ref.new(browser(base))
  }

  go(
    session: Ref<Browser>,
    method: String,
    path: String,
    body: Option<String>,
  ) -> Response / {Net, Mut, Throws<ClientError>} {
    let reply = visit(Ref.get(session), method, path, body)

    Ref.set(session, reply.browser)
    reply.response
  }

  go_follow(
    session: Ref<Browser>,
    method: String,
    path: String,
    body: Option<String>,
  ) -> Response / {Net, Mut, Throws<ClientError>} {
    let reply = follow(visit(Ref.get(session), method, path, body))

    Ref.set(session, reply.browser)
    reply.response
  }

  browser(base: String) -> Browser {
    { base: trim_slash(base), cookies: Map.empty() }
  }

  visit(browser: Browser, method: String, path: String, body: Option<String>) -> Visit / {
    Net,
    Throws<ClientError>,
  } {
    match body {
      None -> visit_with(browser, method, path, [], ""),
      Some(text) -> visit_with(
        browser,
        method,
        path,
        [{ name: "content-type", value: "application/x-www-form-urlencoded" }],
        text,
      ),
    }
  }

  visit_with(
    browser: Browser,
    method: String,
    path: String,
    headers: List<Header>,
    body: String,
  ) -> Visit / {Net, Throws<ClientError>} {
    let cookie = cookie_header(browser.cookies)
    let sent = if cookie == "" {
      headers
    } else {
      List.append(headers, [{ name: "cookie", value: cookie }])
    }
    let reply = Net.request(
      { ..request_options(method, "#{browser.base}#{path}"), headers: sent, body: body },
    )

    match reply {
      Ok(response) -> { browser: remember(browser, response), response: response },
      Err(error) -> throw error,
    }
  }

  follow(reply: Visit) -> Visit / {Net, Throws<ClientError>} {
    let location = Http.header(reply.response.headers, "location")
    let base = reply.browser.base

    if location == "" {
      reply
    } else if String.starts_with(location, "/") {
      visit(reply.browser, "GET", location, None)
    } else if String.starts_with(location, base) {
      visit(
        reply.browser,
        "GET",
        String.slice(location, String.length(base), String.length(location)),
        None,
      )
    } else {
      reply
    }
  }

  remember(browser: Browser, response: Response) -> Browser {
    let jar = List.fold(
      response.headers,
      browser.cookies,
      function(cookies, header) {
        if String.lowercase(header.name) == "set-cookie" {
          apply_cookie(cookies, header.value)
        } else {
          cookies
        }
      },
    )

    { ..browser, cookies: jar }
  }

  apply_cookie(cookies: Map<String, String>, line: String) -> Map<String, String> {
    match String.split(line, ";") {
      [] -> cookies,
      [pair, ..attributes] -> match String.split_once(pair, "=") {
        None -> cookies,
        Some(parts) -> {
          let name = String.trim(parts.before)

          if name == "" {
            cookies
          } else if expired(attributes) {
            Map.remove(cookies, name)
          } else {
            Map.insert(cookies, name, String.trim(parts.after))
          }
        }
      },
    }
  }

  expired(attributes: List<String>) -> Bool {
    List.any(
      attributes,
      function(attribute) {
        let text = String.lowercase(String.trim(attribute))

        text == "max-age=0"
          || String.starts_with(text, "max-age=-")
          || String.starts_with(text, "expires=") && String.contains(text, "1970")
      },
    )
  }

  cookie_header(cookies: Map<String, String>) -> String {
    List.join(
      List.map(
        List.reverse(Map.to_list(cookies)),
        function(entry) { "#{entry.key}=#{entry.value}" },
      ),
      "; ",
    )
  }

  trim_slash(base: String) -> String {
    if String.ends_with(base, "/") {
      trim_slash(String.slice(base, 0, String.length(base) - 1))
    } else {
      base
    }
  }

  run_all(
    cases: List<{ file: String, name: String, line: Int, run: function() -> {} / {| e} }>,
    timeout_ms: Int,
  ) -> {} / {Async | e} {
    run_each(cases, timeout_ms)
    finish()
  }

  run_each(
    cases: List<{ file: String, name: String, line: Int, run: function() -> {} / {| e} }>,
    timeout_ms: Int,
  ) -> {} / {Async | e} {
    match cases {
      [] -> {},
      [test, ..rest] -> {
        let start: Start = {
          event: "start",
          name: test.name,
          file: test.file,
          line: test.line,
        }

        emit(Json.encode(start))

        let started = clock()
        let outcome = guard(test.run, timeout_ms)
        let ms = clock() - started

        emit(Json.encode(ended(test.name, outcome, ms)))
        run_each(rest, timeout_ms)
      }
    }
  }

  ended(name: String, outcome: Outcome, ms: Float) -> End {
    match outcome {
      Pass -> plain(name, "pass", ms),
      Timeout -> plain(name, "timeout", ms),
      Fail(problem) -> failed(name, "fail", ms, problem),
      Error(problem) -> failed(name, "error", ms, problem),
    }
  }

  plain(name: String, outcome: String, ms: Float) -> End {
    {
      event: "end",
      name: name,
      outcome: outcome,
      ms: ms,
      kind: None,
      message: None,
      at: None,
    }
  }

  failed(name: String, outcome: String, ms: Float, problem: Problem) -> End {
    {
      event: "end",
      name: name,
      outcome: outcome,
      ms: ms,
      kind: present(problem.kind),
      message: Some(problem.message),
      at: present(problem.at),
    }
  }

  present(text: String) -> Option<String> {
    if text == "" { None } else { Some(text) }
  }

  emit(line: String) {
    Log.info("\u{1e}#{line}")
  }

exports
  Verdict
  Mismatch
  Captured
  capture
  assert_snapshot
  assert_snapshot_with
  RequestOptions
  ClientError
  Browser
  Visit
  App
  Node
  Native
  Net
  run_all
  request_options
  request
  get
  browser
  send
  session
  go
  go_follow
  visit
  visit_with
  follow
  remember
  cookie_header
  mock
  with_app
  with_app_env
  run_browser
  log
